  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && node scripts/check.mjs && npm test",
    "build": "node scripts/package.mjs",
    "zip": "npm run build",
    "cws:upload": "node scripts/chrome-web-store-release.mjs upload",
