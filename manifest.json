{
  "manifest_version": 3,
  "name": "YouTube Music - Hide Video & Custom Themes",
  "version": "1.0.0",
  "description": "Hide the video, give your queue room to breathe, and make YouTube Music yours with custom themes and player controls.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Customize YouTube Music"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/settings.js", "src/content.js"],
      "run_at": "document_start"
    }
  ]
}
